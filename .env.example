# --- Local development (official workflow) -----------------------------------
# Supabase CLI provides local services. FastAPI runs separately on host.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
SUPABASE_JWT_SECRET=<local-jwt-secret>
ADMIN_EMAIL=
ADMIN_PASSWORD=

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Geocoding is optional in local dev. Keep disabled to avoid external calls.
GEOCODING_PROVIDER=disabled

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_MAILTO=mailto:admin@girospesa.it
WEBHOOK_SECRET=
FRONTEND_URL=http://127.0.0.1:3000

# Copy local values from: supabase status -o env
# SUPABASE_SERVICE_ROLE_KEY <- SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET       <- JWT_SECRET
# For admin seeding, set ADMIN_EMAIL and ADMIN_PASSWORD explicitly.

# --- Cloud / deployed environment -------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_JWT_SECRET=<jwt-secret>
# GOOGLE_API_KEY=<google-api-key>
# GEOCODING_PROVIDER=nominatim
