# Variabili per i test di integrazione contro lo stack Supabase locale via
# `supabase start`.
# Non usare mai valori di produzione qui.
# Avvia lo stack con: cd lista-spesa-furba-backend && supabase start

# API URL locale esposta da Supabase CLI
SUPABASE_URL=http://127.0.0.1:54321

SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
SUPABASE_ANON_KEY=<local-anon-key>
ADMIN_EMAIL=test-admin@local.test
ADMIN_PASSWORD=TestAdmin123!

# Richiesto da core/config.py
SUPABASE_JWT_SECRET=<local-jwt-secret>

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEOCODING_PROVIDER=disabled
FRONTEND_URL=http://127.0.0.1:3000
