# Variabili per i test di integrazione contro lo stack Docker isolato.
# Non usare mai valori di produzione qui.
# Avvia lo stack con:
# .venv/bin/python -m scripts.integration_stack up

# API URL esposta dal Kong dedicato ai test
SUPABASE_URL=http://127.0.0.1:55421
DB_DSN=postgresql://postgres:postgres@127.0.0.1:55422/postgres

SUPABASE_SERVICE_ROLE_KEY=<integration-service-role-key>
SUPABASE_ANON_KEY=<integration-anon-key>
ADMIN_EMAIL=test-admin@local.test
ADMIN_PASSWORD=TestAdmin123!

# Richiesto da core/config.py
SUPABASE_JWT_SECRET=integration-test-jwt-secret-with-at-least-32-chars
APP_SESSION_SECRET=integration-test-app-session-secret-with-at-least-32-chars

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEOCODING_PROVIDER=disabled
FRONTEND_URL=http://127.0.0.1:3000
